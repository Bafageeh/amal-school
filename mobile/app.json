{
  "expo": {
    "name": "Amal Preview",
    "slug": "amal-school",
    "scheme": "amalpreview",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EEF4FF",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF4FF"
    },
    "android": {
      "package": "sa.pm.amal.preview",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "extra": {
      "apiBaseUrl": "https://amal.pm.sa"
    }
  }
}
